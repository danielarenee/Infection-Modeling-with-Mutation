Notebook[{
Cell[TextData[StyleBox["Equilibria and stability analysis for SIRCmw (with I \
scaling factor instead of SI)\n\n1. Disease Free Equilibrium",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.994644920290247*^9, 
  3.994644931142714*^9}},ExpressionUUID->"5f20fe0d-5c0e-4cf6-b46b-\
ba7da381f15c"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"first", " ", "lets", " ", "define", " ", "the", " ", 
    RowBox[{"model", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"we", " ", "are", " ", "assuming", " ", "\[Epsilon]1"}], " ", "=",
     " ", 
    RowBox[{"\[Epsilon]2", " ", "=", " ", "\[Epsilon]"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{"dS", "=", 
     RowBox[{
      RowBox[{"\[Mu]", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "S"}], ")"}]}], "-", 
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dI", "=", 
     RowBox[{
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Mu]", "+", "\[Alpha]"}], ")"}], "*", "II"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Sigma]"}], ")"}], "*", "\[Beta]", "*", "CC", "*",
        "II"}], "+", 
      RowBox[{"\[Alpha]", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "R"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dC", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}], "-", 
      RowBox[{"\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "CC"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  3.994644942416046*^9, {3.9946449952460947`*^9, 3.994645010641274*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"e4e1b83a-bdce-446b-afd5-b7164b2ca380"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"S", ",", "II", ",", "R", ",", "CC"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhs", "=", 
    RowBox[{"{", 
     RowBox[{"dS", ",", "dI", ",", "dR", ",", "dC"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"now", " ", "we", " ", "get", " ", "the", " ", "jacobian"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"rhs", ",", 
       RowBox[{"{", "vars", "}"}]}], "]"}], "//", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"and", " ", "evaluate", " ", "in", " ", "X_", "0"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JDFE", "=", 
    RowBox[{
     RowBox[{"J", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "->", "1"}], ",", 
        RowBox[{"II", "->", "0"}], ",", 
        RowBox[{"R", "->", "0"}], ",", 
        RowBox[{"CC", "->", "0"}]}], "}"}]}], "//", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Jacobian at DFE:\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"JDFE", "//", "MatrixForm"}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"now", " ", "we", " ", "compute", " ", "the", " ", "eigenvalues"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evalsDFE", "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "JDFE", "]"}], "//", "Simplify"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", "\"\<\\nEigenvalues at DFE:\>\"", "]"}], "\n", 
 RowBox[{"Print", "[", "evalsDFE", "]"}]}], "Input",
 CellChangeTimes->{{3.994644945110071*^9, 3.99464498181981*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"27fb9028-f28d-4063-93f3-a502af1f42df"],

