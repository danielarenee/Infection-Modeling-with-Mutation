Cell[TextData[{
 "\n",
 StyleBox["2. Endemic Equilibrium \n",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.994644959374311*^9, 
  3.994644966464581*^9}},ExpressionUUID->"65c42bfb-467f-4828-bef4-\
f2c8d142b7db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "we", " ", "set", " ", "all", " ", "derivatives", " ", "to", " ", "zero"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqEqs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dS", "==", "0"}], ",", 
       RowBox[{"dI", "==", "0"}], ",", 
       RowBox[{"dR", "==", "0"}], ",", 
       RowBox[{"dC", "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "divide", " ", "the", " ", "dI", " ", "equation", " ", "by", " ", "II", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"because", " ", "we", " ", "are", " ", "assuming", " ", "II"}],
        "!=", 
       RowBox[{"0", " ", "for", " ", "endemic", " ", "state"}]}], ")"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"eqI", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Beta]", "*", "S"}], "+", 
       RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC"}]}], "==", 
      RowBox[{"\[Mu]", "+", "\[Alpha]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"and", " ", "rebuild", " ", "the", " ", "system"}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"eqSystem", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dS", "==", "0"}], ",", "eqI", ",", 
       RowBox[{"dR", "==", "0"}], ",", 
       RowBox[{"dC", "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"eliminate", " ", "S"}], ",", "R", ",", 
     RowBox[{
     "and", " ", "CC", " ", "to", " ", "get", " ", "a", " ", "reduced", " ", 
      "equation", " ", "only", " ", "in", " ", "terms", " ", "of", " ", 
      "II"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"reduced", "=", 
     RowBox[{
      RowBox[{"Eliminate", "[", 
       RowBox[{"eqSystem", ",", 
        RowBox[{"{", 
         RowBox[{"S", ",", "R", ",", "CC"}], "}"}]}], "]"}], "//", 
      "Simplify"}]}], ";"}], "\n", 
   RowBox[{"Print", "[", "\"\<\\nReduced equation in I only:\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", "reduced", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"lets", " ", "extract", " ", "the", " ", "left", " ", "side"}], 
     "..."}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"poly", "=", 
     RowBox[{"reduced", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "and", " ", "collect", " ", "by", " ", "powers", " ", "of", " ", "II", " ",
      "to", " ", "see", " ", "the", " ", "degree", " ", "of", " ", "the", " ",
      "polynomial"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyI", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{"poly", ",", "II", ",", "Simplify"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<\\nPolynomial collected by powers of I:\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", "polyI", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9946449678109913`*^9, 3.9946449773560047`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"56026bb4-2b48-4dc4-bc8b-05e9ae219e32"],

