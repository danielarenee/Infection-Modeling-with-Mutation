Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Abort", " ", "the", " ", "running", " ", "cell", " ", 
    RowBox[{"first", "!"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Amat", ",", "bvec"}], "}"}], "=", 
     RowBox[{"CoefficientArrays", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dS", ",", "dR", ",", "dC"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"S", ",", "R", ",", "CC"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bvec", "=", 
     RowBox[{"-", 
      RowBox[{"Normal", "[", "bvec", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"CoefficientArrays", " ", "gives", " ", 
       RowBox[{"{", 
        RowBox[{"const", ",", "matrix"}], "}"}]}], ";", 
      RowBox[{"const", " ", "on", " ", "LHS"}]}], ",", 
     RowBox[{"so", " ", "negate"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Amat", "=", 
     RowBox[{"Normal", "[", "Amat", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solVec", "=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"Amat", ",", "bvec"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Sstar", ",", "Rstar", ",", "Cstar"}], "}"}], "=", "solVec"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<S* = \>\"", ",", "Sstar"}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<R* = \>\"", ",", "Rstar"}], "]"}], "\n", 
