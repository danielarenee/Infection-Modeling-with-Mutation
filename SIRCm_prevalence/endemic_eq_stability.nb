In[81]:=",ExpressionUUID->"9d333892-674c-4f64-85b3-c246ff293a21"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Mu]", " ", 
   RowBox[{"(", 
    RowBox[{"\[Alpha]", "-", "\[Beta]", "+", "\[Mu]"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"\[Gamma]", "+", "\[Mu]"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"\[Delta]", "+", "\[Mu]"}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["II", "3"], " ", "\[Beta]", " ", "\[Delta]", " ", 
   "\[Epsilon]", " ", "\[Mu]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", "\[Epsilon]"}], "+", 
     RowBox[{"\[Beta]", " ", "\[Sigma]"}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["II", "2"], " ", "\[Mu]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Beta]", "+", 
        RowBox[{"\[Gamma]", " ", "\[Epsilon]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"\[Beta]", "+", 
        RowBox[{"\[Delta]", " ", "\[Epsilon]"}]}], ")"}]}], "+", 
     RowBox[{"\[Gamma]", " ", "\[Delta]", " ", 
      SuperscriptBox["\[Epsilon]", "2"], " ", "\[Mu]"}], "+", 
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Mu]", "-", 
        RowBox[{"\[Delta]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Epsilon]"}], ")"}], " ", 
         "\[Sigma]"}]}], ")"}]}], "+", 
     RowBox[{"\[Beta]", " ", "\[Epsilon]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "\[Delta]"}], "-", 
           RowBox[{"\[Delta]", " ", "\[Epsilon]"}], "+", "\[Mu]"}], ")"}]}], "+", 
        RowBox[{"\[Delta]", " ", "\[Mu]", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Sigma]"}], ")"}]}]}], ")"}]}]}], ")"}]}], "+", 
  
  RowBox[{"II", " ", "\[Mu]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Delta]", " ", "\[Epsilon]", " ", 
      SuperscriptBox["\[Mu]", "2"]}], "+", 
     RowBox[{"\[Gamma]", " ", "\[Epsilon]", " ", "\[Mu]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "\[Delta]"}], "+", "\[Mu]"}], ")"}]}], "+", 
     RowBox[{"\[Alpha]", " ", "\[Beta]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Gamma]", "+", "\[Delta]", "+", 
        RowBox[{"2", " ", "\[Mu]"}]}], ")"}]}], "+", 
     RowBox[{"\[Beta]", " ", "\[Gamma]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Delta]", "-", 
        RowBox[{"2", " ", "\[Delta]", " ", "\[Epsilon]"}], "+", "\[Mu]", "-", 
        
        RowBox[{"\[Epsilon]", " ", "\[Mu]"}]}], ")"}]}], "+", 
     RowBox[{"\[Alpha]", " ", "\[Epsilon]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Delta]", " ", "\[Mu]"}], "+", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "\[Delta]"}], "+", "\[Mu]"}], ")"}]}]}], ")"}]}],
      "-", 
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"\[Mu]", "+", 
        RowBox[{"\[Delta]", " ", "\[Sigma]"}]}], ")"}]}], "+", 
     RowBox[{"\[Beta]", " ", "\[Mu]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "\[Mu]"}], "+", 
        RowBox[{"\[Delta]", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Epsilon]", "+", "\[Sigma]"}], ")"}]}]}], 
       ")"}]}]}], ")"}]}]}]], "Print",
