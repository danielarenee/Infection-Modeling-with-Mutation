Notebook[{
Cell["\<\
lets define the model (SIRCmw with I instead of SI and with a single \
epsilon1=epsilon2=epsilon)
\
\>", "Text",
 CellChangeTimes->{{3.994840792671754*^9, 
  3.994840823679769*^9}},ExpressionUUID->"3c6e9334-3a79-4824-99d3-\
d706cd69f5a7"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{"dS", "=", 
     RowBox[{
      RowBox[{"\[Mu]", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "S"}], ")"}]}], "-", 
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dI", "=", 
     RowBox[{
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Mu]", "+", "\[Alpha]"}], ")"}], "*", "II"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Sigma]"}], ")"}], "*", "\[Beta]", "*", "CC", "*",
        "II"}], "+", 
      RowBox[{"\[Alpha]", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "R"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dC", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}], "-", 
      RowBox[{"\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "CC"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]", "*", "II"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"{", 
      RowBox[{"S", ",", "II", ",", "R", ",", "CC"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhs", "=", 
     RowBox[{"{", 
      RowBox[{"dS", ",", "dI", ",", "dR", ",", "dC"}], "}"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9948408246366043`*^9, 3.994840834560535*^9}, {
  3.994840869302277*^9, 3.994840889624999*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"17e530ba-9c3f-4665-9928-ebeb0b5c8e18"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{
  3.994842106225363*^9, {3.9948422705553703`*^9, 
   3.994842271850502*^9}},ExpressionUUID->"3c4272cc-00a5-4103-bcf5-\
179e0a2ca21b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eqEqs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dS", "==", "0"}], ",", 
       RowBox[{"dI", "==", "0"}], ",", 
       RowBox[{"dR", "==", "0"}], ",", 
       RowBox[{"dC", "==", "0"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "divide", " ", "the", " ", "dI", " ", "equation", " ", "by", " ", "II", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"because", " ", "we", " ", "are", " ", "assuming", " ", "II"}],
        "!=", 
       RowBox[{"0", " ", "for", " ", "endemic", " ", "state"}]}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqI", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Beta]", "*", "S"}], "+", 
       RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC"}]}], "==", 
      RowBox[{"\[Mu]", "+", "\[Alpha]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"and", " ", "rebuild", " ", "the", " ", "system"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqSystem", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dS", "==", "0"}], ",", "eqI", ",", 
       RowBox[{"dR", "==", "0"}], ",", 
       RowBox[{"dC", "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"eliminate", " ", "S"}], ",", "R", ",", 
     RowBox[{
     "and", " ", "CC", " ", "to", " ", "get", " ", "a", " ", "reduced", " ", 
      "equation", " ", "only", " ", "in", " ", "terms", " ", "of", " ", 
      "II"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"reduced", "=", 
     RowBox[{
      RowBox[{"Eliminate", "[", 
       RowBox[{"eqSystem", ",", 
        RowBox[{"{", 
         RowBox[{"S", ",", "R", ",", "CC"}], "}"}]}], "]"}], "//", 
      "Simplify"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"lets", " ", "extract", " ", "the", " ", "left", " ", "side"}], 
     "..."}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"poly", "=", 
     RowBox[{"reduced", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "and", " ", "collect", " ", "by", " ", "powers", " ", "of", " ", "II", " ",
      "to", " ", "see", " ", "the", " ", "degree", " ", "of", " ", "the", " ",
      "polynomial"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"polyI", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{"poly", ",", "II", ",", "Simplify"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<\\nPolynomial collected by powers of I:\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", "polyI", "]"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9948422726827173`*^9, 3.994842272961384*^9}, {
  3.994842337248679*^9, 3.994842340840391*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"0f211b1f-9527-4290-9b79-f51bd62f58c1"],

Cell[CellGroupData[{

Cell[BoxData["\<\"\\nPolynomial collected by powers of I:\"\>"], "Print",
