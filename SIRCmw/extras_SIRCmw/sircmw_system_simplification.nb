Cell["\<\

We get the same polynomial that we have for the 4-variable original polynomial

Now lets compare the 4-var and the 3-var polynomials obtained with Eliminate\
\>", "Text",
 CellChangeTimes->{{3.992486592202574*^9, 3.99248660481201*^9}, {
  3.992487689376772*^9, 
  3.9924877361279163`*^9}},ExpressionUUID->"5beb2460-0e45-4083-968a-\
ca8f23fcf848"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"paramVals", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Mu]", "->", "0.02"}], ",", 
       RowBox[{"\[Beta]", "->", "600"}], ",", 
       RowBox[{"\[Alpha]", "->", 
        RowBox[{"365", "/", "3"}]}], ",", 
       RowBox[{"\[Sigma]", "->", "0.07874"}], ",", 
       RowBox[{"\[Gamma]", "->", "0.35"}], ",", 
       RowBox[{"\[Delta]", "->", 
        RowBox[{"1", "/", "1.61"}]}], ",", 
       RowBox[{"\[Epsilon]", "->", "200"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"polyElim1Num", "=", 
     RowBox[{"poly1", "/.", " ", "paramVals"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"3", "-", "var"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"polyOriginalNum", "=", 
     RowBox[{"poly", "/.", " ", "paramVals"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"4", "-", "var"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyGBNum", " ", "=", " ", 
     RowBox[{"polyGB1", "/.", "paramVals"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyOriginalGBNum", " ", "=", " ", 
     RowBox[{"polyGB4", " ", "/.", "paramVals"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootsReduced", "=", 
     RowBox[{"II", "/.", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"polyElim1Num", "==", "0"}], ",", "II"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rootsOriginal", "=", 
     RowBox[{"II", "/.", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"polyOriginalNum", "==", "0"}], ",", "II"}], "]"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootsReducedGB", " ", "=", " ", 
     RowBox[{"II", "/.", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"polyGBNum", " ", "==", " ", "0"}], ",", " ", "II"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rootsOriginalGB", " ", "=", " ", 
     RowBox[{"II", "/.", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"polyOriginalGBNum", " ", "==", " ", "0"}], ",", " ", "II"}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nRoots of 3-var polynomial (using Eliminate):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "rootsReduced", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nRoots of original polynomial (using Eliminate):\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "rootsOriginal", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nRoots of 3-var polynomial (using GB):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "rootsReducedGB", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nRoots of original polynomial (using GB):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "rootsOriginalGB", "]"}], ";"}]}]}]], "Input",
