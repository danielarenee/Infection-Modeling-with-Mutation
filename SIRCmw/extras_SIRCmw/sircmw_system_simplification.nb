                 SuperscriptBox["\[Sigma]", "2"]}], ")"}]}]}], ")"}]}]}], 
          ")"}]}]}], ")"}]}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["II", "2"], " ", "\[Mu]", " ", 
