Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"original", " ", "SIRCmw", " ", 
    RowBox[{"model", ":"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dS", "=", 
   RowBox[{
    RowBox[{"\[Mu]", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", "S"}], ")"}]}], "-", 
    RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", " ", 
       RowBox[{"\[Epsilon]", "*", "S", "*", "II"}]}], ")"}], "*", "\[Gamma]", 
     "*", "CC"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dI", "=", 
   RowBox[{
    RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
    RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC", "*", "II"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Mu]", "+", "\[Alpha]"}], ")"}], "*", "II"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dR", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Sigma]"}], ")"}], "*", "\[Beta]", "*", "CC", "*", 
     "II"}], "+", 
    RowBox[{"\[Alpha]", "*", "II"}], "-", 
    RowBox[{"\[Mu]", "*", "R"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Epsilon]", "*", "S", "*", "II"}]}], ")"}], "*", "\[Delta]", 
     "*", "R"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dC", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Epsilon]", "*", "S", "*", "II"}]}], ")"}], "*", "\[Delta]",
       "*", "R"}], "-", 
     RowBox[{"\[Beta]", "*", "CC", "*", "II"}], "-", 
     RowBox[{"\[Mu]", "*", "CC"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Epsilon]", "*", "S", "*", "II"}]}], ")"}], "*", "\[Gamma]",
       "*", "CC"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"S", ",", "II", ",", "R", ",", "CC"}], "}"}]}], ";"}]}], "Input",
