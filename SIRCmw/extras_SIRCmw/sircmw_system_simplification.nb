Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Rewrite", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<CASE 1: Eliminate S\>\"", ",", "Bold", ",", "14"}], "]"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subS", "=", 
     RowBox[{"S", "->", 
      RowBox[{"1", "-", "II", "-", "R", "-", "CC"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dI1", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"dI", "/.", " ", "subS"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR1", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"dR", "/.", " ", "subS"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dC1", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"dC", "/.", " ", "subS"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Reduced system (I, R, C):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<dI/dt = \>\"", ",", "dI1"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<dR/dt = \>\"", ",", "dR1"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<dC/dt = \>\"", ",", "dC1"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Jacobian", " ", "and", " ", "Disease", " ", "free", " ", "equilibrium"}],
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars1", "=", 
     RowBox[{"{", 
      RowBox[{"II", ",", "R", ",", "CC"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhs1", "=", 
     RowBox[{"{", 
      RowBox[{"dI1", ",", " ", "dR1", ",", " ", "dC1"}], "}"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J1", "=", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"rhs1", ",", 
        RowBox[{"{", "vars1", "}"}]}], "]"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JDFE1", "=", 
     RowBox[{
      RowBox[{"J1", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"II", "->", "0"}], ",", 
         RowBox[{"R", "->", "0"}], ",", 
         RowBox[{"CC", "->", "0"}]}], "}"}]}], "//", "Simplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<\\nJacobian at DFE (Case 1):\>\"", "]"}], "\n", 
   
   RowBox[{"Print", "[", 
    RowBox[{"JDFE1", "//", "MatrixForm"}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evalsDFE1", "=", 
     RowBox[{
      RowBox[{"Eigenvalues", "[", "JDFE1", "]"}], "//", "Simplify"}]}], ";"}],
    "\n", 
   RowBox[{"Print", "[", "\"\<\\nEigenvalues at DFE:\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", "evalsDFE1", "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Endemic", " ", "equilibrium"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "we", " ", "divide", " ", "by", " ", "I", " ", "assuming", " ", "its", " ",
      "not", " ", "0", " ", "for", " ", "endemic", " ", "state"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quotient1", "=", 
     RowBox[{"PolynomialQuotient", "[", 
      RowBox[{"dI1", ",", "II", ",", "II"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqSystem1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"quotient1", "==", "0"}], ",", 
       RowBox[{"dR1", "==", "0"}], ",", 
       RowBox[{"dC1", "==", "0"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reduced1", "=", 
     RowBox[{
      RowBox[{"Eliminate", "[", 
       RowBox[{"eqSystem1", ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "CC"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"poly1", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"reduced1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "II", ",", "Simplify"}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nEndemic polynomial in I (Case 1): \>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "poly1", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Degree in I: \>\"", ",", 
      RowBox[{"Exponent", "[", 
       RowBox[{"poly1", ",", "II"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
