Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{"dS", "=", 
     RowBox[{
      RowBox[{"\[Mu]", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "S"}], ")"}]}], "-", 
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{"\[Epsilon]2", "*", "g"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dI", "=", 
     RowBox[{
      RowBox[{"\[Beta]", "*", "S", "*", "II"}], "+", 
      RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Mu]", "+", "\[Alpha]"}], ")"}], "*", "II"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dR", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Sigma]"}], ")"}], "*", "\[Beta]", "*", "CC", "*",
        "II"}], "+", 
      RowBox[{"\[Alpha]", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "R"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]1", "*", "g"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dC", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]1", "*", "g"}]}], ")"}], "*", "\[Delta]", "*", 
       "R"}], "-", 
      RowBox[{"\[Beta]", "*", "CC", "*", "II"}], "-", 
      RowBox[{"\[Mu]", "*", "CC"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"\[Epsilon]2", "*", "g"}]}], ")"}], "*", "\[Gamma]", "*", 
       "CC"}]}]}], ";"}], "\[IndentingNewLine]"}]}]], "Input",
